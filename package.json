{
  "name": "spendspacey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test:unit": "node scripts/with-test-env.mjs exec vitest run",
    "test:config": "node scripts/check-config.mjs",
    "test:delivery": "node scripts/check-delivery.mjs",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "test:e2e": "node scripts/with-test-env.mjs exec playwright test",
    "secret:scan": "node scripts/secret-scan.mjs",
    "build:test": "node scripts/with-test-env.mjs build --mode development",
    "test:pwa": "node scripts/check-pwa.mjs",
    "test:pwa:versions": "node scripts/prepare-pwa-versions.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.19",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1"
  }
}
