# Vite replaces the origin marker with validated public configuration at build time.
# Cache-Control rules are disjoint: Pages combines matching header values.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https:; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/auth/callback
  Cache-Control: no-store

/google-g.png
  Cache-Control: no-cache

/fonts/*
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
